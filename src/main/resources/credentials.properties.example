# ==============================================================
# Plantilla de Configuración de Base de Datos Oracle Cloud
# ==============================================================
# Renombra o copia este archivo como 'credentials.properties'
# y coloca tus credenciales reales:

# 1. db.name: Alias del servicio en tu tnsnames.ora (ej. uxvibedb_high)
db.name=NOMBRE_DE_TU_CONEXION_HIGH

# 2. db.user: Usuario de Oracle (ej. ADMIN)
db.user=ADMIN

# 3. db.pass: Contraseña de tu base de datos
db.pass=TU_PASSWORD_AQUI
